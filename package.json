{
  "name": "wafiq-superstores",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Product listing website for Wafiq Superstores",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "gen:lottie": "node scripts/gen-lottie.mjs",
    "gen:data": "node scripts/gen-products.mjs",
    "scrape:naheed": "node scripts/scrape-naheed.mjs 3",
    "import:naheed": "node scripts/import-naheed.mjs",
    "images:webp": "node scripts/to-webp.mjs",
    "gen:scene": "node scripts/gen-scene-placeholders.mjs",
    "gen:tiles": "node scripts/gen-product-tiles.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.2.5",
    "@gsap/react": "^2.1.2",
    "@hono/node-server": "^2.1.3",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.13.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lenis": "^1.3.4",
    "lottie-web": "^5.12.2",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "zod": "^4.6.5"
  }
}
